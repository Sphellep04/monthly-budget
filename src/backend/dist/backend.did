type UserSettings = record {alertThresholdPercent: nat;};
type UserId = principal;
type Timestamp = int;
type RecurringTemplateInput = 
 record {
   amountCents: nat;
   budgetId: nat;
   dayOfMonth: nat;
   name: text;
   notes: opt text;
 };
type RecurringTemplate = 
 record {
   amountCents: nat;
   budgetId: nat;
   createdAt: Timestamp;
   dayOfMonth: nat;
   id: nat;
   name: text;
   notes: opt text;
   owner: UserId;
 };
type Note = 
 record {
   content: text;
   createdAt: Timestamp;
   id: text;
   title: text;
   updatedAt: Timestamp;
   userId: principal;
 };
type MonthlyTrendPoint = 
 record {
   month: nat;
   totalSpentCents: nat;
   year: nat;
 };
type MonthlySummary = 
 record {
   budgets: vec BudgetSummary;
   month: nat;
   totalBudgetCents: nat;
   totalSpentCents: nat;
   year: nat;
 };
type ExpenseInput = 
 record {
   amountCents: nat;
   budgetId: nat;
   date: text;
   notes: opt text;
   receiptUrl: opt text;
 };
type Expense = 
 record {
   amountCents: nat;
   budgetId: nat;
   createdAt: Timestamp;
   date: text;
   id: nat;
   notes: opt text;
   owner: UserId;
   receiptUrl: opt text;
   recurringTemplateId: opt nat;
 };
type DailySpendingPoint = 
 record {
   amountCents: int;
   day: nat;
 };
type CategoryTrendPoint = 
 record {
   budgetId: nat;
   budgetName: text;
   limitCents: nat;
   month: nat;
   spentCents: nat;
   year: nat;
 };
type CategoryBreakdownPoint = 
 record {
   amountCents: int;
   budgetId: text;
   color: text;
   name: text;
 };
type BudgetTemplateInput = 
 record {
   categories: vec BudgetTemplateCategory;
   name: text;
 };
type BudgetTemplateCategory = 
 record {
   category: text;
   color: text;
   limitCents: nat;
   name: text;
 };
type BudgetTemplate = 
 record {
   categories: vec BudgetTemplateCategory;
   createdAt: Timestamp;
   id: text;
   name: text;
   owner: UserId;
 };
type BudgetSummary = 
 record {
   budget: Budget;
   remainingCents: int;
   totalSpentCents: nat;
 };
type BudgetInput = 
 record {
   category: text;
   color: text;
   limitCents: nat;
   month: nat;
   name: text;
   year: nat;
 };
type Budget = 
 record {
   category: text;
   color: text;
   createdAt: Timestamp;
   id: nat;
   limitCents: nat;
   month: nat;
   name: text;
   owner: UserId;
   year: nat;
 };
type BillPaymentInput = 
 record {
   dueDay: nat;
   month: nat;
   notes: opt text;
   paidAmountCents: opt nat;
   paidDate: opt Timestamp;
   recurringTemplateId: text;
   year: nat;
 };
type BillPayment = 
 record {
   dueDay: nat;
   id: text;
   month: nat;
   notes: opt text;
   owner: UserId;
   paidAmountCents: opt nat;
   paidDate: opt Timestamp;
   recurringTemplateId: text;
   year: nat;
 };
service : {
  applyBudgetTemplate: (templateId: text, year: nat, month: nat) ->
   (vec Budget);
  applyRecurringTemplates: (year: nat, month: nat) -> (vec Expense);
  createBillPayment: (input: BillPaymentInput) -> (BillPayment);
  createBudget: (input: BudgetInput) -> (Budget);
  createBudgetTemplate: (input: BudgetTemplateInput) -> (BudgetTemplate);
  createExpense: (input: ExpenseInput) -> (Expense);
  createNote: (title: text, content: text) -> (Note);
  createRecurringTemplate: (input: RecurringTemplateInput) ->
   (RecurringTemplate);
  deleteBillPayment: (id: text) -> (bool);
  deleteBudget: (id: nat) -> (bool);
  deleteBudgetTemplate: (id: text) -> (bool);
  deleteExpense: (id: nat) -> (bool);
  deleteNote: (id: text) -> (bool);
  deleteRecurringTemplate: (id: nat) -> (bool);
  getBillPayment: (id: text) -> (opt BillPayment) query;
  getBudget: (id: nat) -> (opt Budget) query;
  getBudgetTemplate: (id: text) -> (opt BudgetTemplate) query;
  getCategoryBreakdown: (year: nat, month: nat) ->
   (vec CategoryBreakdownPoint) query;
  getCategoryBreakdownForRange: (startDate: text, endDate: text) ->
   (vec CategoryBreakdownPoint) query;
  getCategoryTrend: (budgetId: nat, months: nat, currentYear: nat,
   currentMonth: nat) -> (vec CategoryTrendPoint) query;
  getDailySpending: (year: nat, month: nat) -> (vec DailySpendingPoint) query;
  getExpense: (id: nat) -> (opt Expense) query;
  getExpensesInRange: (startDate: text, endDate: text) -> (vec Expense) query;
  getMonthlySummary: (year: nat, month: nat) -> (MonthlySummary) query;
  getMonthlyTrend: (months: nat, currentYear: nat, currentMonth: nat) ->
   (vec MonthlyTrendPoint) query;
  getRecurringTemplate: (id: nat) -> (opt RecurringTemplate) query;
  getUserSettings: () -> (UserSettings) query;
  listBillPayments: (year: nat, month: nat) -> (vec BillPayment) query;
  listBudgetTemplates: () -> (vec BudgetTemplate) query;
  listBudgets: (year: nat, month: nat) -> (vec Budget) query;
  listExpenses: (budgetId: nat) -> (vec Expense) query;
  listNotes: () -> (vec Note) query;
  listRecurringTemplates: (budgetId: nat) -> (vec RecurringTemplate) query;
  searchExpenses: (startDate: text, endDate: text, queryText: opt text,
   categoryId: opt nat, minAmountCents: opt nat, maxAmountCents: opt nat) ->
   (vec Expense) query;
  updateBillPayment: (id: text, input: BillPaymentInput) -> (opt BillPayment);
  updateBudget: (id: nat, input: BudgetInput) -> (opt Budget);
  updateBudgetTemplate: (id: text, input: BudgetTemplateInput) ->
   (opt BudgetTemplate);
  updateExpense: (id: nat, input: ExpenseInput) -> (opt Expense);
  updateNote: (id: text, title: text, content: text) -> (opt Note);
  updateRecurringTemplate: (id: nat, input: RecurringTemplateInput) ->
   (opt RecurringTemplate);
  updateUserSettings: (settings: UserSettings) -> (UserSettings);
}
